generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Food {
  id        Int      @id @default(autoincrement())
  title     String
  category FoodCategory @relation(fields: [foodCategoryId] , references: [id])
  foodCategoryId Int
  createdAt DateTime @default(now())
}

model FoodCategory {
id Int @id @default(autoincrement())
name String
foods Food[]
}